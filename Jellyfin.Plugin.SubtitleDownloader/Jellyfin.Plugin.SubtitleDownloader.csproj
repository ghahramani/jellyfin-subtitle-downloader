<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <RootNamespace>Jellyfin.Plugin.SubtitleDownloader</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.SubtitleDownloader</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-*" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-*" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.css" />
    <EmbeddedResource Include="Configuration\configPage.css" />
    <None Remove="Web\SubtitleDownloader.js" />
    <EmbeddedResource Include="Web\SubtitleDownloader.js" />
    <None Remove="Web\SubtitleDownloader.css" />
    <EmbeddedResource Include="Web\SubtitleDownloader.css" />
  </ItemGroup>

</Project>
